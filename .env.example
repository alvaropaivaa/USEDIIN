# Copie para .env e preencha. O .env real não vai para o Git.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
VITE_VAPID_PUBLIC_KEY=

# IA (chat com foto, PDF e áudio, e o assistente no WhatsApp). Desligada = o chat roda no modo simples, sem IA.
# Ligue só depois de publicar a função assistente no Supabase.
# VITE_IA=on

# Número do assistente no WhatsApp (só dígitos, com DDI). Vazio = esconde o assistente no WhatsApp.
# VITE_WHATSAPP_NUMBER=
